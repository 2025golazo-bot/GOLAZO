# Supabase（プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
# Square Webhook からの書き込みなど、RLSを回避してサーバー側だけで使う秘密鍵。
# 絶対にクライアントに露出させないこと（NEXT_PUBLIC_を付けない）。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Square（Developer Dashboard > Webhooks から取得）
SQUARE_WEBHOOK_SIGNATURE_KEY=xxxxxxxx
# 本番URL。Square側に登録したWebhook通知先URLと完全に一致させること。
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.example.com/api/square-webhook

# ダッシュボードの月間売上目標（円）
NEXT_PUBLIC_MONTHLY_SALES_TARGET=1000000
